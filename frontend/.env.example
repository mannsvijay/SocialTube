# Copy this file to .env.local for local development. Never commit .env.local.
# On Vercel, add these keys under Project -> Settings -> Environment Variables.
# Vite bakes them into the build, so redeploy after changing them.

# Backend API base URL, including /api/v1 and without a trailing slash.
# Local:      http://localhost:8000/api/v1
# Production: https://your-backend.onrender.com/api/v1
VITE_API_URL=http://localhost:8000/api/v1

# Shown in the browser tab title
VITE_APP_NAME=SocialTube
