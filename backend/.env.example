# Copy this file to .env and fill in the values. Never commit .env.
# On Render, add these same keys under Environment instead of using a file.

# Port the server listens on. Render sets PORT itself, you don't need to add it there.
PORT=8000

# "production" on Render: auth cookies become Secure + SameSite=None so they work across
# your Vercel and Render domains. Use "development" locally (plain http on localhost).
NODE_ENV=development

# Frontend URL(s) allowed to call the API with cookies. Comma separated, no trailing slash.
# "*" can be used as a wildcard inside an entry, e.g. https://socialtube-*.vercel.app for preview deploys.
# Local:      http://localhost:5173
# Production: https://your-app.vercel.app
CORS_ORIGIN=http://localhost:5173

# MongoDB Atlas -> Database -> Connect -> Drivers. Put the database name after the host, e.g.
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/videotube?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/videotube?retryWrites=true&w=majority

# Long random strings, different from each other. Generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
ACCESS_TOKEN_SECRET=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=replace-with-a-different-long-random-string
REFRESH_TOKEN_EXPIRY=10d

# Cloudinary dashboard -> Settings -> API Keys
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
